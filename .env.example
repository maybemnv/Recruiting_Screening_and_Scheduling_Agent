# Local fixture mode requires no secrets.
RECRUITING_STORE_BACKEND=sqlite
RECRUITING_SQLITE_PATH=.local/demo.sqlite3

# Supabase mode is server-only. Never expose the service role key to web/app.js.
# Apply supabase/migrations/001_recruiting_demo.sql first, then set:
# RECRUITING_STORE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>
